$TTL 604800
@   IN  SOA     ns1.myorg.net. admin.myorg.net. (
            2026032201 ; Serial
            604800
            86400
            2419200
            604800 )

@       IN  NS      ns1.myorg.net.
@       IN  NS      ns2.myorg.net.

; PTR Records (Mapping the last octet to the domain name)

138     IN  PTR     ns1.myorg.net.
139     IN  PTR     ns2.myorg.net.

; Students must complete below
; 136 is the Load Balancer, which acts as our main 'www' entry point
136     IN  PTR     www.myorg.net.

; 142 is the Router IP
142     IN  PTR     router.myorg.net.

; add for other services (The backend web servers)
129     IN  PTR     www1.myorg.net.
130     IN  PTR     www2.myorg.net.
131     IN  PTR     www3.myorg.net.
132     IN  PTR     www4.myorg.net.